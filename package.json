{
  "name": "stefan-brkljacic-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.js",
    "test": "node --test tests/unit/*.unit.js",
    "test:e2e": "playwright test",
    "lint": "eslint scripts tests tools *.config.js && stylelint 'styles/*.css'",
    "validate:html": "html-validate index.html",
    "check": "npm run lint && npm run validate:html && npm run validate:translations && npm test && npm run test:e2e",
    "validate:translations": "node tools/check-translations.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
