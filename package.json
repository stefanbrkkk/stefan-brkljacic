{
  "name": "stefan-brkljacic-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/unit/*.unit.js",
    "test:e2e": "playwright test",
    "lint": "eslint scripts tests tools *.config.js && stylelint 'styles/*.css'",
    "validate:html": "html-validate index.html",
    "check": "npm run lint && npm run validate:html && npm run validate:translations && npm run validate:artwork && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "validate:translations": "node tools/check-translations.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "artwork": "node tools/bake-book-pages.js",
    "validate:artwork": "node tools/validate-artwork.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/three": "^0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "sharp": "^0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
